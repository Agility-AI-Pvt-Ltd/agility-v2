# Site chatbot System 1 — OpenRouter Jev Decision Model (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Jev Decision Model (default: typesafe/jev-1.14)
# JEV_MODEL=typesafe/jev-1.14
# Optional System 2 synthesizer on OpenRouter (default: meta-llama/llama-3.3-70b-instruct)
# OPENROUTER_SYNTHESIS_MODEL=meta-llama/llama-3.3-70b-instruct

# Alternative System 2 synthesizer — Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Book a call uses WhatsApp (Bhawna) — see BOOK_CALL_WHATSAPP_URL in src/lib/company.ts

# Contact form (Nodemailer SMTP) — Message us on /contact
# For Gmail: use an App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Comma-separated inbox(es) that receive form submissions (all get the same email)
CONTACT_FORM_TO=organisation@agilityai.in,someone@agilityai.in,another@agilityai.in
# Optional From header (defaults to SMTP_USER)
# CONTACT_FORM_FROM="Agility AI Website <organisation@agilityai.in>"

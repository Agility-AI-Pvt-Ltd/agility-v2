# Site chatbot — Groq (https://console.groq.com/keys)
# Required for full "Talk to us" answers grounded in site content.
GROQ_API_KEY=
# Optional override (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Book a call uses WhatsApp (Bhawna) — see BOOK_CALL_WHATSAPP_URL in src/lib/company.ts
# Legacy form API (optional, unused by default UI):
# BOOK_CALL_TO_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
